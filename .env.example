# Copy to .env and fill locally. Existing process variables take precedence.
# Never commit credentials. Use a SELECT-only account for the dashboard.
# Initialization and imports need separate appropriate privileges.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cyberfraud
DB_USER=
DB_PASSWORD=
# For remote MySQL, provide a trusted CA file to enable verified TLS.
DB_SSL_CA=
# Optional integration database: must be isolated and end with _test.
TEST_DB_NAME=cyberfraud_test
TEST_DB_USER=
TEST_DB_PASSWORD=
RUN_MYSQL_INTEGRATION=0
